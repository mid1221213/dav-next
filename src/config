ngx_addon_name=dav-next

# nginx has robust builtin support for linking against
# libxml2+libxslt.  This is definitelty the right way to go if
# building nginx with the xslt module, in which case libxslt will
# be linked anyway.  In other cases libxslt is just redundant.
# If that's a big deal, libxml2 can be linked directly:
# ngx_module_libs=-lxml2

CFLAGS="$CFLAGS -g -O0"

ngx_module_type=HTTP
have=NGX_DEBUG . auto/have

ngx_module_name="dav_next_module"
ngx_module_deps="$ngx_addon_dir/auth.h \
                 $ngx_addon_dir/fileops.h \
                 $ngx_addon_dir/handlers.h \
                 $ngx_addon_dir/locks.h \
                 $ngx_addon_dir/module.h \
                 $ngx_addon_dir/utils.h \
                 $ngx_addon_dir/webdav.h \
                 $ngx_addon_dir/dav-next.h"
ngx_module_srcs="$ngx_addon_dir/auth.c \
                 $ngx_addon_dir/fileops.c \
                 $ngx_addon_dir/handlers.c \
                 $ngx_addon_dir/locks.c \
                 $ngx_addon_dir/module.c \
                 $ngx_addon_dir/utils.c \
                 $ngx_addon_dir/webdav.c"
ngx_module_libs="LIBXSLT"

. auto/module

ngx_module_name="dav_next_auth_basic_module"
ngx_module_deps="$ngx_addon_dir/auth-basic.h \
                 $ngx_addon_dir/utils.h \
                 $ngx_addon_dir/dav-next.h"
ngx_module_srcs="$ngx_addon_dir/auth-basic.c"
ngx_module_libs=""

. auto/module

ngx_module_name="dav_next_auth_ldap_module"
ngx_module_srcs="$ngx_addon_dir/auth-ldap.c \
		 $ngx_addon_dir/auth-ldap-impl.c"
ngx_module_libs="-lldap -llber"

. auto/module
